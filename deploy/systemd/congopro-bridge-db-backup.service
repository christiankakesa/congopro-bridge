[Unit]
Description=Congopro Bridge database backup
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=postgres
Group=postgres

ExecStart=/opt/congopro-bridge/scripts/db-backup.sh congopro_bridge /opt/congopro-bridge/backups 14

# Hardening
NoNewPrivileges=true
PrivateTmp=true
