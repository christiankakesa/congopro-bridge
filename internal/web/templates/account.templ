package templates

import (
	"congopro-bridge/internal/claims"
	"congopro-bridge/internal/customers"
	"congopro-bridge/internal/promotions"
)

// Customer account pages under /account: passwordless email-OTP login and a
// minimal dashboard. Mirrors AdminLayout's structure (noindex utility pages,
// same input/button classes) so both areas feel like one product.

templ AccountLayout(title, nonce, email string) {
	<!DOCTYPE html>
	<html lang="fr" class="h-full">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } · Congopro</title>
			<meta name="robots" content="noindex,nofollow"/>
			@commonHead(nonce, CSSVersion)
		</head>
		<body class="bg-surface text-ink antialiased min-h-full flex flex-col">
			<!-- The brand lockup is the way back to the site and renders for
			     signed-out visitors too (login/verify) — without it those pages
			     are a dead end. Identity and logout stay signed-in only. -->
			<header class="bg-surface-raised border-b border-line">
				<div class="max-w-3xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between gap-3">
					<a href="/" preload="mousedown" class="flex items-center gap-2 shrink-0" aria-label="Congopro Bridge — retour à l'accueil">
						@brandMark("w-6 h-6 logo-a")
						<span class="wordmark font-sora font-semibold text-[17px]">
							<span class="logo-a">Congopro</span> <span class="logo-b">Bridge.</span>
						</span>
					</a>
					if email != "" {
						<div class="flex items-center gap-4 text-sm min-w-0">
							<span class="text-ink-faint truncate">{ email }</span>
							<form method="post" action="/account/logout">
								<button type="submit" class="text-ink-faint hover:text-ink shrink-0">Déconnexion</button>
							</form>
						</div>
					}
				</div>
			</header>
			<main class="flex-1 w-full max-w-3xl mx-auto px-4 sm:px-6 py-8">
				{ children... }
			</main>
			@SiteFooter(nonce)
		</body>
	</html>
}

templ AccountLoginPage(nonce, errorMsg, next string) {
	@AccountLayout("Connexion", nonce, "") {
		<div class="max-w-sm mx-auto mt-16">
			<h1 class="text-xl font-sora font-semibold text-ink mb-2">Mon compte</h1>
			<p class="text-sm text-ink-faint mb-6">Recevez un code de connexion par email — pas de mot de passe.</p>
			if errorMsg != "" {
				<div class="mb-4 rounded-lg bg-danger-soft border border-danger-soft text-danger text-sm px-4 py-3">
					{ errorMsg }
				</div>
			}
			<form method="post" action="/account/login" class="space-y-4">
				if next != "" {
					<input type="hidden" name="next" value={ next }/>
				}
				<div>
					<label for="email" class="block text-sm font-medium text-ink-muted mb-1">Email</label>
					<input
						type="email"
						id="email"
						name="email"
						required
						autocomplete="username"
						class="field-input"
					/>
				</div>
				<button
					type="submit"
					class="btn btn-primary w-full"
				>
					Recevoir mon code
				</button>
			</form>
		</div>
	}
}

// cooldown is true when the request hit the 60s resend throttle: no second
// email was sent, so the page must not claim one was.
templ AccountVerifyPage(nonce, email, errorMsg string, cooldown bool, next string) {
	@AccountLayout("Vérification", nonce, "") {
		<div class="max-w-sm mx-auto mt-16">
			if cooldown {
				<h1 class="text-xl font-sora font-semibold text-ink mb-2">Code déjà envoyé</h1>
				<p class="text-sm text-ink-faint mb-6">
					Un code a été envoyé à
					<span class="font-medium text-ink-muted">{ email }</span>
					il y a moins d'une minute — il est toujours valable.
					Saisissez-le ci-dessous, ou attendez une minute pour en demander un nouveau.
				</p>
			} else {
				<h1 class="text-xl font-sora font-semibold text-ink mb-2">Code envoyé</h1>
				<p class="text-sm text-ink-faint mb-6">
					Saisissez le code à 6 chiffres envoyé à
					<span class="font-medium text-ink-muted">{ email }</span>.
					Il est valable 10&nbsp;minutes.
				</p>
			}
			if errorMsg != "" {
				<div class="mb-4 rounded-lg bg-danger-soft border border-danger-soft text-danger text-sm px-4 py-3">
					{ errorMsg }
				</div>
			}
			<form method="post" action="/account/verify" class="space-y-4">
				<input type="hidden" name="email" value={ email }/>
				if next != "" {
					<input type="hidden" name="next" value={ next }/>
				}
				<div>
					<label for="code" class="block text-sm font-medium text-ink-muted mb-1">Code (6 chiffres)</label>
					<input
						type="text"
						id="code"
						name="code"
						inputmode="numeric"
						pattern="[0-9]{6}"
						maxlength="6"
						required
						autocomplete="one-time-code"
						class="field-input tracking-widest"
					/>
				</div>
				<button
					type="submit"
					class="btn btn-primary w-full"
				>
					Me connecter
				</button>
			</form>
			<p class="mt-4 text-xs text-ink-faint">
				Pas reçu ? Un nouveau code peut être demandé après 1&nbsp;minute —
				<a href="/account/login" class="underline hover:text-ink">renvoyer</a>.
			</p>
		</div>
	}
}

templ AccountDashboard(nonce string, cust *customers.Customer, myClaims []claims.Claim) {
	{{
		email := ""
		if cust != nil {
			email = cust.Email
		}
	}}
	@AccountLayout("Mon compte", nonce, email) {
		<div class="max-w-lg mt-8">
			<h1 class="text-xl font-sora font-semibold text-ink mb-2">Mon compte</h1>
			<p class="text-sm text-ink-faint mb-6">Connecté en tant que { email }.</p>

			if len(myClaims) > 0 {
				<h2 class="text-base font-sora font-semibold text-ink mt-8 mb-3">Mes réclamations</h2>
				<div class="rounded-lg border border-line bg-surface-raised divide-y divide-line">
					for _, cl := range myClaims {
						<div class="px-4 py-3 flex items-center justify-between gap-3">
							<div class="min-w-0">
								<p class="text-sm font-medium text-ink truncate">{ cl.CompanyName }</p>
								<p class="text-xs text-ink-faint mt-0.5">{ cl.CreatedAt.Format("02/01/2006") }</p>
							</div>
							<div class="flex items-center gap-2 shrink-0">
								@claimStatusBadge(cl.Status)
								if cl.Status == "approved" {
									<a href="/account/promote" preload="mousedown" class="btn btn-primary h-9 px-3.5 text-xs">Mettre en avant</a>
								}
							</div>
						</div>
					}
				</div>
			} else {
				<div class="rounded-lg border border-line bg-surface-sunken px-4 py-5 text-sm text-ink-faint">
					Vous n'avez pas encore réclamé d'entreprise. Ouvrez une fiche entreprise puis
					«&nbsp;Réclamer cette entreprise&nbsp;» pour la rattacher à votre compte.
				</div>
			}

			<div class="mt-8 rounded-2xl border border-line bg-surface-raised shadow-card p-4 flex items-center justify-between gap-3">
				<div class="min-w-0">
					<p class="text-sm font-medium text-ink">Mise en avant</p>
					<p class="text-xs text-ink-muted mt-0.5">Faites ressortir une entreprise que vous avez réclamée.</p>
				</div>
				<a href="/account/promote" preload="mousedown" class="btn btn-secondary h-9 px-3.5 text-xs shrink-0">Voir l'offre</a>
			</div>

			<form method="post" action="/account/logout" class="mt-6">
				<button
					type="submit"
					class="rounded-lg border border-line text-ink-muted text-sm font-medium px-4 py-2 hover:bg-surface-sunken transition-colors"
				>
					Se déconnecter
				</button>
			</form>
		</div>
	}
}

templ AccountClaimPage(nonce, email, companySlug, companyName string, state claims.CompanyState, errorMsg string) {
	@AccountLayout("Réclamer une entreprise", nonce, email) {
		<div class="max-w-lg mt-8">
			<h1 class="text-xl font-sora font-semibold text-ink mb-1">Réclamer une entreprise</h1>
			<p class="text-sm text-ink-faint mb-6">
				{ companyName } — rattachée à <span class="font-medium text-ink-muted">{ email }</span>
			</p>

			if errorMsg != "" {
				<div class="mb-4 rounded-lg bg-danger-soft border border-danger-soft text-danger text-sm px-4 py-3">
					{ errorMsg }
				</div>
			}

			if state.Claimed {
				<div class="rounded-lg bg-positive-soft border border-positive-soft text-positive text-sm px-4 py-3">
					if state.ClaimedByMe {
						Cette entreprise est déjà rattachée à votre compte.
					} else {
						Cette entreprise est déjà revendiquée par un autre compte vérifié.
					}
				</div>
			} else if state.Pending {
				<div class="rounded-lg bg-warning-soft border border-warning-soft text-warning text-sm px-4 py-3">
					if state.PendingByMe {
						Votre réclamation est en cours d'examen par notre équipe. Vous recevrez un email à la décision.
					} else {
						Une réclamation est déjà en cours pour cette entreprise.
					}
				</div>
			} else {
				<form method="post" action="/account/claim" class="space-y-4">
					<input type="hidden" name="company_slug" value={ companySlug }/>
					<div>
						<label for="relationship" class="block text-sm font-medium text-ink-muted mb-1">Votre relation avec cette entreprise</label>
						<select
							id="relationship"
							name="relationship"
							required
							class="field-input"
						>
							<option value="owner">Propriétaire</option>
							<option value="manager">Gérant</option>
							<option value="employee">Employé</option>
							<option value="other">Autre</option>
						</select>
					</div>
					<div>
						<label for="phone" class="block text-sm font-medium text-ink-muted mb-1">Téléphone (facultatif)</label>
						<input
							type="tel"
							id="phone"
							name="phone"
							autocomplete="tel"
							class="field-input"
						/>
					</div>
					<div>
						<label for="evidence" class="block text-sm font-medium text-ink-muted mb-1">
							Justification — pourquoi cette entreprise vous appartient-elle ?
						</label>
						<textarea
							id="evidence"
							name="evidence"
							rows="5"
							required
							minlength="20"
							maxlength="4000"
							class="field-input"
						></textarea>
						<p class="text-xs text-ink-faint mt-1">Au moins 20 caractères. Notre équipe vérifie chaque demande.</p>
					</div>
					<button
						type="submit"
						class="btn btn-primary w-full"
					>
						Envoyer ma réclamation
					</button>
				</form>
			}
		</div>
	}
}

templ claimStatusBadge(status string) {
	{{ label, cls := claimStatusBadgeStyle(status) }}
	<span class={ "inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium " + cls }>{ label }</span>
}

func claimStatusBadgeStyle(status string) (string, string) {
	switch status {
	case "approved":
		return "Approuvée", "bg-positive-soft text-positive border border-positive-soft"
	case "rejected":
		return "Refusée", "bg-danger-soft text-danger border border-danger-soft"
	default:
		return "En attente", "bg-warning-soft text-warning border border-warning-soft"
	}
}

func claimRelationshipLabel(r string) string {
	switch r {
	case "owner":
		return "Propriétaire"
	case "manager":
		return "Gérant"
	case "employee":
		return "Employé"
	default:
		return "Autre"
	}
}


templ AccountPromotePage(nonce, email string, eligible []promotions.EligibleCompany, current []promotions.Promotion, priceStr string, ok, canceled bool) {
	@AccountLayout("Mise en avant", nonce, email) {
		<div class="max-w-lg mt-8">
			<h1 class="text-xl font-sora font-semibold text-ink mb-1">Mise en avant</h1>
			<p class="text-sm text-ink-faint mb-6">
				Votre entreprise remonte en tête des résultats de recherche, avec un badge «&nbsp;Promu&nbsp;» sur sa fiche et dans les résultats.
				if priceStr != "" {
					{ priceStr }, sans engagement — résiliable à tout moment.
				}
			</p>

			if ok {
				<div class="mb-4 rounded-lg bg-positive-soft border border-positive-soft text-positive text-sm px-4 py-3">
					Paiement confirmé — votre mise en avant est active (l'activation peut prendre quelques secondes).
				</div>
			}
			if canceled {
				<div class="mb-4 rounded-lg bg-warning-soft border border-warning-soft text-warning text-sm px-4 py-3">
					Paiement annulé — aucun montant n'a été prélevé.
				</div>
			}

			if len(current) > 0 {
				<h2 class="text-base font-sora font-semibold text-ink mt-6 mb-3">Mes mises en avant</h2>
				<div class="rounded-lg border border-line bg-surface-raised divide-y divide-line mb-6">
					for _, pr := range current {
						<div class="px-4 py-3 flex items-center justify-between gap-3">
							<div class="min-w-0">
								<p class="text-sm font-medium text-ink truncate">{ pr.CompanyName }</p>
								if pr.CurrentPeriodEnd != nil && pr.Status != "canceled" {
									<p class="text-xs text-ink-faint mt-0.5">Renouvellement le { pr.CurrentPeriodEnd.Format("02/01/2006") }</p>
								}
							</div>
							@promoStatusBadge(pr.Status)
						</div>
					}
				</div>
			}

			<h2 class="text-base font-sora font-semibold text-ink mt-6 mb-3">Promouvoir une entreprise</h2>
			if len(eligible) > 0 {
				<div class="rounded-lg border border-line bg-surface-raised divide-y divide-line">
					for _, co := range eligible {
						{{ citySuffix := ""; if co.City != "" { citySuffix = " · " + co.City } }}
						<div class="px-4 py-3 flex items-center justify-between gap-3">
							<div class="min-w-0">
								<p class="text-sm font-medium text-ink truncate">{ co.Name }</p>
								if co.Activity != "" || co.City != "" {
									<p class="text-xs text-ink-faint mt-0.5 truncate">{ co.Activity + citySuffix }</p>
								}
							</div>
							<form method="post" action="/account/promote" class="shrink-0">
								<input type="hidden" name="company_slug" value={ co.NameSeo }/>
								<button
									type="submit"
									class="rounded-lg bg-accent hover:bg-accent-hover text-white text-xs font-medium px-3.5 py-2 transition-colors"
								>
									Promouvoir
								</button>
							</form>
						</div>
					}
				</div>
				<p class="mt-3 text-xs text-ink-faint">Le paiement est traité par Stripe. Aucune donnée bancaire ne transite par Congopro.</p>
			} else {
				<div class="rounded-lg border border-line bg-surface-sunken px-4 py-5 text-sm text-ink-faint">
					Aucune entreprise éligible. Pour promouvoir une entreprise, réclamez-la d'abord depuis sa fiche
					(<span class="text-ink-muted">«&nbsp;Réclamer&nbsp;»</span>) et attendez la validation de notre équipe.
				</div>
			}
		</div>
	}
}

func promoStatusBadgeStyle(status string) (string, string) {
	switch status {
	case "active":
		return "Active", "bg-positive-soft text-positive border border-positive-soft"
	case "past_due":
		return "Paiement en attente", "bg-warning-soft text-warning border border-warning-soft"
	case "pending":
		return "En cours", "bg-warning-soft text-warning border border-warning-soft"
	default:
		return "Résiliée", "bg-surface-sunken text-ink-faint border border-line"
	}
}

templ promoStatusBadge(status string) {
	{{ label, cls := promoStatusBadgeStyle(status) }}
	<span class={ "inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium whitespace-nowrap " + cls }>{ label }</span>
}
