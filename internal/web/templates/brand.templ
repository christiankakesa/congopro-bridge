package templates

// brandMark renders the official Congopro mark (charte 2026) as inline
// vector paths lifted from the designer's master file — no image request,
// ~1.6 KB. It inherits currentColor: pair it with .logo-a so it is brand
// red in light theme and white in dark (the designer's inverse variant).
templ brandMark(class string) {
	<svg viewBox="0 0 64 64" class={ class } fill="currentColor" aria-hidden="true">
		<g transform="translate(-178.516,-142.445) scale(0.77739)">
			<path d="M 249.617188 225.835938 C 250.285156 236.453125 258.753906 245.132812 269.355469 246.042969 C 271.882812 246.261719 274.332031 246.042969 276.632812 245.457031 C 278.222656 245.054688 279.898438 245.625 280.941406 246.890625 L 283.355469 249.816406 C 279.582031 251.679688 275.335938 252.726562 270.839844 252.726562 C 255.21875 252.726562 242.546875 240.0625 242.546875 224.429688 C 242.546875 208.800781 255.21875 196.136719 270.839844 196.136719 C 277.683594 196.136719 283.957031 198.5625 288.847656 202.601562 L 287.367188 204.398438 C 286.023438 206.027344 283.699219 206.519531 281.855469 205.488281 C 278.726562 203.734375 275.113281 202.738281 271.269531 202.738281 C 258.820312 202.738281 248.824219 213.214844 249.617188 225.835938 "/>
<path d="M 299.136719 224.429688 C 299.136719 233.214844 295.132812 241.066406 288.855469 246.253906 L 287.355469 244.441406 C 286.007812 242.804688 286.066406 240.4375 287.476562 238.851562 C 290.890625 235.023438 292.964844 229.96875 292.964844 224.429688 C 292.964844 220.804688 292.074219 217.386719 290.503906 214.382812 C 289.707031 212.859375 289.902344 211.007812 290.992188 209.683594 L 293.167969 207.050781 C 296.90625 211.84375 299.136719 217.878906 299.136719 224.429688 "/>
<path d="M 266.421875 218.820312 C 263.214844 216.890625 260.199219 217.4375 258.039062 218.414062 C 257.632812 218.597656 257.199219 218.199219 257.375 217.785156 C 259.015625 213.90625 262.238281 210.859375 266.238281 209.457031 C 266.769531 209.273438 267.230469 209.859375 266.941406 210.339844 C 265.710938 212.394531 264.808594 215.367188 266.421875 218.820312 "/>
