# Congopro Bridge environment. Copy to .env and edit — .env is gitignored.
#
# Style (matches kora-vpn): no trailing comments after a value. Everything
# after `=` is the value, so an inline comment would end up inside it.
# Document above the key instead. Values may be single- or double-quoted —
# one matching quote layer is stripped by the loader.
#
# WHO READS THIS FILE: the app itself (internal/config loadDotEnv — only for
# keys the real environment doesn't define; systemd and docker compose keep
# precedence) and docker compose natively. The Makefile deliberately does NOT
# include it: make expands `$` sequences inside values, which silently
# corrupts passwords (observed: a 12-char SMTP password reaching the app as
# 4 chars, and the mail server answering a misleading 535). `$` in values is
# safe here.
#
# LOCAL DEV: the make targets (db-up, db-migrate, make dev, mail-up, …) fill
# in the local database URL themselves. The app also reads OLLAMA_URL /
# MEILI_URL defaults that match the docker-compose services.

# --- App ----------------------------------------------------------------------

# HTTP listen port (native app and compose app container).
PORT='8090'

# "*" allows any website to call the API cross-origin; empty disables CORS.
# Production should stay empty or an explicit origin.
ALLOWED_ORIGIN='*'

# --- Search & AI (docker compose provides these locally) ----------------------

OLLAMA_URL='http://127.0.0.1:11434'
GENERATIVE_MODEL='gemma3:1b'
EMBEDDING_MODEL='nomic-embed-text'
MEILI_URL='http://127.0.0.1:7700'
MEILI_INDEX_NAME='companies'
# Local Meilisearch runs unauthenticated (dev only); production gets its key
# from secrets.env on the server — never put it in this file.
MEILI_MASTER_KEY=''

# Extra Ollama origins/hosts (comma-separated) — leave empty for local use.
OLLAMA_ALLOWED_HOSTS=''
OLLAMA_ALLOW_PUBLIC_IP='false'

# --- Email (SMTP) -------------------------------------------------------------

# Nothing sends email yet (see TODO.md) — these configure the account so it
# can be proven working first:  make mail-test TO=you@example.com
#
# OVH EmailPro: the submission host is shown in your OVH control panel
# (commonly ssl0.ovh.net). Port 587 with SMTP_TLS=starttls is the usual
# submission setup; port 465 needs SMTP_TLS=implicit. The username is the
# FULL mailbox address, not a short name, and SMTP_FROM must be a mailbox
# you actually own on the domain or the provider will reject the send.
#
# Leave SMTP_HOST empty to disable email entirely. Setting some but not all
# of these is refused at boot — a half-configured account only fails later,
# when a customer is waiting for their code.
#
# Local capture instead of a real mailbox: make mail-up, then
# SMTP_HOST='localhost' SMTP_PORT='1025' SMTP_TLS='none' and empty
# credentials — the sender never transmits a password unencrypted.
SMTP_HOST=''
SMTP_PORT='587'
SMTP_USERNAME=''
SMTP_PASSWORD=''
SMTP_FROM=''
SMTP_FROM_NAME='Congopro'
# starttls (587) | implicit (465) | none (local capture only, no credentials)
SMTP_TLS='starttls'

# --- Deploy (VPS over SSH — see docs/DEPLOY.md) --------------------------------

DEPLOY_HOST=''
DEPLOY_USER='ops'
DEPLOY_PORT='4242'
SSH_KEY='~/.ssh/id_ed25519'
REMOTE_DIR='/opt/congopro-bridge'
DOMAIN='congopro.com'

# --- Database -----------------------------------------------------------------

# Local dev: set automatically by the make db-* targets (docker compose,
# port 5433). Production: generated on the server by secrets-init into
# secrets.env — never store it here.
DATABASE_URL=''
