package templates

// StaticPage renders a fully server-rendered content page (help, privacy,
// terms). bodyHTML is trusted, admin-authored markup (from
// internal/web/content/*.html) injected as-is via templ.Raw — the same trust
// boundary the old client-side fetch-and-inject flow already crossed.
templ StaticPage(title, description, canonicalURL, nonce, cssVersion, heading, bodyHTML string) {
	@Layout(title, description, canonicalURL, nonce, cssVersion) {
		@siteHeader()
		<div class="w-full max-w-3xl mx-auto px-4 sm:px-6 pt-10 pb-28">
			<h1 class="text-3xl font-sora font-semibold text-ink mb-6">{ heading }</h1>
			<div class="content-page">
				@templ.Raw(bodyHTML)
			</div>
		</div>
	}
}
