package templates

import (
	"fmt"
	"net/url"
	"strconv"
)

// AdminPageSize is the admin list page size — shared with the API handlers
// so the "1–50 sur N" range label and the SQL LIMIT can never drift.
const AdminPageSize = 50

// AdminCompanyCounts backs the status filter chips; counts respect the
// active search term so the chips describe the current result set.
type AdminCompanyCounts struct {
	Total     int
	Published int
	Draft     int
	Disputed  int
}

templ AdminCompaniesList(nonce string, nav AdminNav, query, status string, counts AdminCompanyCounts, companies []AdminCompanyRow, page int, hasNext bool) {
	@AdminLayout("Entreprises", nonce, nav) {
		<div class="flex items-center justify-between gap-3 mb-6">
			<h1 class="text-xl font-sora font-semibold text-ink">Entreprises</h1>
			<a href="/admin/companies/new" class="btn btn-primary">+ Nouvelle entreprise</a>
		</div>
		<form method="get" action="/admin/companies" class="mb-4">
			<input
				type="search"
				name="q"
				value={ query }
				placeholder="Recherche instantanée — nom…"
				aria-label="Rechercher une entreprise"
				class="field-input max-w-sm"
				hx-get="/admin/companies"
				hx-trigger="input changed delay:300ms, search"
				hx-target="#companiesTable"
				hx-swap="outerHTML"
				hx-push-url="true"
				hx-include="#statusField"
				hx-indicator="#companiesTable"
			/>
		</form>
		@AdminCompaniesTable(query, status, counts, companies, page, hasNext)
	}
}

// AdminCompaniesTable is the live-search swap target: filter chips, table and
// pagination, re-rendered alone on htmx requests. #statusField travels with
// it so the search box keeps the active filter across swaps.
templ AdminCompaniesTable(query, status string, counts AdminCompanyCounts, companies []AdminCompanyRow, page int, hasNext bool) {
	<div id="companiesTable">
		<input type="hidden" id="statusField" name="status" value={ status }/>
		<div class="flex flex-wrap items-center gap-2 mb-4">
			@companyFilterChip(query, status, "", "Toutes", counts.Total)
			@companyFilterChip(query, status, "published", "Publiées", counts.Published)
			@companyFilterChip(query, status, "draft", "Brouillons", counts.Draft)
			@companyFilterChip(query, status, "disputed", "Litiges", counts.Disputed)
		</div>
		<div class="bg-surface-raised rounded-2xl border border-line shadow-card overflow-x-auto">
			<table class="w-full text-sm">
				<thead class="bg-surface-sunken text-ink-faint text-xs uppercase tracking-wide">
					<tr>
						<th class="text-left px-4 py-2.5 font-medium">Entreprise</th>
						<th class="text-left px-4 py-2.5 font-medium">Ville</th>
						<th class="text-left px-4 py-2.5 font-medium">Statut</th>
						<th class="text-left px-4 py-2.5 font-medium">Mis à jour</th>
						<th class="px-4 py-2.5"></th>
					</tr>
				</thead>
				<tbody class="divide-y divide-line">
					for _, c := range companies {
						<tr class="hover:bg-surface-sunken transition-colors">
							<td class="px-4 py-2.5">
								<div class="flex items-center gap-3">
									<span
										class="admin-avatar"
										style={ fmt.Sprintf("--av-h:%d", NameToHue(c.Name)) }
										aria-hidden="true"
									>
										{ Initials(c.Name) }
									</span>
									<span class="min-w-0">
										<span class="block font-medium text-ink truncate">{ c.Name }</span>
										if c.Activity != "" {
											<span class="block text-xs text-ink-faint truncate">{ TruncateActivity(c.Activity) }</span>
										}
									</span>
								</div>
							</td>
							<td class="px-4 py-2.5 text-ink-muted">
								{ c.City }
								if c.Country != "" {
									<span class="block text-xs text-ink-faint">{ c.Country }</span>
								}
							</td>
							<td class="px-4 py-2.5">
								@statusBadge(c.Status)
							</td>
							<td class="px-4 py-2.5 text-ink-faint whitespace-nowrap">{ c.UpdatedAt }</td>
							<td class="px-4 py-2.5 text-right">
								<a href={ templ.URL("/admin/companies/" + c.ID + "/edit") } class="text-accent hover:underline">
									Modifier
								</a>
							</td>
						</tr>
					}
					if len(companies) == 0 {
						<tr>
							<td colspan="5" class="px-4 py-8 text-center text-ink-faint">Aucune entreprise trouvée.</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		<div class="flex items-center justify-between gap-3 mt-4 text-sm">
			<span class="text-ink-faint">{ rangeLabel(page, len(companies), counts.FilteredTotal(status)) }</span>
			<div class="flex gap-2">
				if page > 1 {
					<a href={ templ.URL(pageURL(query, status, page-1)) } class="px-3 py-1.5 rounded-xl border border-line text-ink-muted hover:bg-surface-sunken">← Précédent</a>
				}
				if hasNext {
					<a href={ templ.URL(pageURL(query, status, page+1)) } class="px-3 py-1.5 rounded-xl border border-line text-ink-muted hover:bg-surface-sunken">Suivant →</a>
				}
			</div>
		</div>
	</div>
}

templ companyFilterChip(query, current, value, label string, count int) {
	<a
		href={ templ.URL(filterURL(query, value)) }
		hx-get={ filterURL(query, value) }
		hx-target="#companiesTable"
		hx-swap="outerHTML"
		hx-push-url="true"
		class={ "admin-chip " + adminChipClass(current == value) }
	>
		{ label }
		<span class="opacity-65">{ formatTotal(count) }</span>
	</a>
}

func adminChipClass(active bool) string {
	if active {
		return "admin-chip-active"
	}
	return ""
}

// FilteredTotal is the count the pagination line describes: the active
// status bucket, or every status when no filter is set.
func (c AdminCompanyCounts) FilteredTotal(status string) int {
	switch status {
	case "published":
		return c.Published
	case "draft":
		return c.Draft
	case "disputed":
		return c.Disputed
	default:
		return c.Total
	}
}

func rangeLabel(page, shown, total int) string {
	if shown == 0 {
		return "Aucun résultat"
	}
	first := (page-1)*AdminPageSize + 1
	return fmt.Sprintf("%s–%s sur %s", formatTotal(first), formatTotal(first+shown-1), formatTotal(total))
}

func filterURL(query, status string) string {
	u := "/admin/companies?status=" + url.QueryEscape(status)
	if query != "" {
		u += "&q=" + url.QueryEscape(query)
	}
	return u
}

func pageURL(query, status string, page int) string {
	u := "/admin/companies?page=" + strconv.Itoa(page)
	if query != "" {
		u += "&q=" + url.QueryEscape(query)
	}
	if status != "" {
		u += "&status=" + url.QueryEscape(status)
	}
	return u
}

templ statusBadge(status string) {
	switch status {
		case "published":
			<span class="badge bg-positive-soft text-positive"><span class="w-1.5 h-1.5 rounded-full bg-current"></span>Publié</span>
		case "draft":
			<span class="badge bg-surface-sunken text-ink-muted"><span class="w-1.5 h-1.5 rounded-full bg-current"></span>Brouillon</span>
		case "disputed":
			<span class="badge bg-warning-soft text-warning"><span class="w-1.5 h-1.5 rounded-full bg-current"></span>Litige</span>
		default:
			<span class="badge bg-surface-sunken text-ink-muted">{ status }</span>
	}
}

templ AdminCompanyForm(nonce string, nav AdminNav, form AdminCompanyFormData, isEdit bool, errorMsg string, fieldErrors map[string]string) {
	@AdminLayout(formTitle(isEdit), nonce, nav) {
		<div class="max-w-2xl pb-24">
			<div class="flex items-center justify-between gap-3 mb-6">
				<div>
					<a href="/admin/companies" class="inline-flex items-center gap-1.5 text-sm text-ink-faint hover:text-ink mb-1">
						<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5m0 0l6-6m-6 6l6 6"></path></svg>
						Entreprises
					</a>
					<h1 class="text-xl font-sora font-semibold text-ink">{ formHeading(isEdit, form.Name) }</h1>
				</div>
				if isEdit {
					@statusBadge(form.Status)
				}
			</div>
			if errorMsg != "" {
				<div class="mb-4 rounded-xl bg-danger-soft border border-danger-soft text-danger text-sm px-4 py-3">
					{ errorMsg }
				</div>
			}
			<form method="post" action={ templ.URL(formAction(isEdit, form.ID)) } class="space-y-4">
				@formSection("Identité") {
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
						@field("Nom *", "name", "text", form.Name, true, fieldErrors["name"])
						@field("Slug (name_seo)", "name_seo", "text", form.NameSeo, false, fieldErrors["name_seo"])
						@field("Activité", "activity", "text", form.Activity, false, "")
						<div>
							<label for="status" class="block text-sm font-medium text-ink-muted mb-1">Statut</label>
							<select id="status" name="status" class={ "field-input " + fieldErrorClass(fieldErrors["status"]) }>
								<option value="draft" selected?={ form.Status == "draft" }>Brouillon</option>
								<option value="published" selected?={ form.Status == "published" }>Publié</option>
								<option value="disputed" selected?={ form.Status == "disputed" }>Litige</option>
							</select>
							@fieldError(fieldErrors["status"])
						</div>
						<div class="sm:col-span-2">
							@field("Slogan", "slogan", "text", form.Slogan, false, "")
						</div>
						<div class="sm:col-span-2">
							<label for="description" class="block text-sm font-medium text-ink-muted mb-1">Description</label>
							<textarea id="description" name="description" rows="4" class="field-input">{ form.Description }</textarea>
						</div>
					</div>
				}
				@formSection("Contact") {
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
						@field("Site web", "website", "url", form.Website, false, fieldErrors["website"])
						@field("Email", "email", "email", form.Email, false, fieldErrors["email"])
						@field("Téléphone", "phone", "text", form.Phone, false, "")
						@field("WhatsApp", "whatsapp", "text", form.Whatsapp, false, "")
					</div>
				}
				@formSection("Adresse & géolocalisation") {
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
						@field("Adresse", "address_line_1", "text", form.AddressLine1, false, "")
						@field("Complément d'adresse", "address_line_2", "text", form.AddressLine2, false, "")
						@field("Ville", "city", "text", form.City, false, "")
						@field("Pays", "country", "text", form.Country, false, "")
						@field("Latitude", "lat", "text", form.Lat, false, fieldErrors["lat"])
						@field("Longitude", "lon", "text", form.Lon, false, fieldErrors["lon"])
					</div>
				}
				@formSection("Réseaux sociaux") {
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
						@field("Twitter/X", "twitter", "text", form.Twitter, false, "")
						@field("Facebook", "facebook", "text", form.Facebook, false, "")
						@field("LinkedIn", "linkedin", "text", form.LinkedIn, false, "")
						@field("Instagram", "instagram", "text", form.Instagram, false, "")
						@field("TikTok", "tiktok", "text", form.TikTok, false, "")
						@field("YouTube", "youtube", "text", form.Youtube, false, "")
					</div>
					<label class="flex items-center gap-3 mt-4 text-sm text-ink-muted cursor-pointer">
						<input type="checkbox" id="stats_show" name="stats_show" checked?={ form.StatsShow } class="switch-input sr-only"/>
						<span class="switch-track" aria-hidden="true"><span class="switch-knob"></span></span>
						Afficher les statistiques publiquement
					</label>
				}
				<div class="admin-savebar">
					<p class="flex-1 min-w-0 text-xs text-ink-faint truncate">
						if isEdit && form.UpdatedAt != "" {
							Dernière modification : { form.UpdatedAt }
						}
					</p>
					<a href="/admin/companies" class="btn btn-secondary">Annuler</a>
					<button type="submit" class="btn btn-primary">Enregistrer</button>
				</div>
			</form>
		</div>
	}
}

templ formSection(title string) {
	<fieldset class="bg-surface-raised rounded-2xl border border-line shadow-card p-5">
		<legend class="sr-only">{ title }</legend>
		<p class="text-sm font-sora font-semibold text-ink mb-4" aria-hidden="true">{ title }</p>
		{ children... }
	</fieldset>
}

templ field(label, name, inputType, value string, required bool, errMsg string) {
	<div>
		<label for={ name } class={ "block text-sm font-medium mb-1 " + fieldLabelClass(errMsg) }>{ label }</label>
		<input
			type={ inputType }
			id={ name }
			name={ name }
			value={ value }
			required?={ required }
			aria-invalid={ ariaInvalid(errMsg) }
			class={ "field-input " + fieldErrorClass(errMsg) }
		/>
		@fieldError(errMsg)
	</div>
}

templ fieldError(msg string) {
	if msg != "" {
		<p class="mt-1.5 flex items-center gap-1.5 text-xs text-danger">
			<svg class="w-3 h-3 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path stroke-linecap="round" d="M12 8v4M12 16h.01"></path></svg>
			{ msg }
		</p>
	}
}

// ariaInvalid returns an explicit "true"/"false": templ's `attr?={cond}`
// would emit a valueless aria-invalid, which ARIA reads as false — the
// error would never reach a screen reader.
func ariaInvalid(msg string) string {
	if msg != "" {
		return "true"
	}
	return "false"
}

func fieldErrorClass(msg string) string {
	if msg != "" {
		return "field-input-error"
	}
	return ""
}

func fieldLabelClass(msg string) string {
	if msg != "" {
		return "text-danger"
	}
	return "text-ink-muted"
}

func formTitle(isEdit bool) string {
	if isEdit {
		return "Modifier l'entreprise"
	}
	return "Nouvelle entreprise"
}

func formHeading(isEdit bool, name string) string {
	if isEdit && name != "" {
		return "Modifier — " + name
	}
	return formTitle(isEdit)
}

func formAction(isEdit bool, id string) string {
	if isEdit {
		return "/admin/companies/" + id + "/edit"
	}
	return "/admin/companies/new"
}
