package templates

import (
	"congopro-bridge/internal/claims"
	"congopro-bridge/internal/customers"
	"congopro-bridge/internal/promotions"
)

// Customer account pages under /account: passwordless email-OTP login and a
// minimal dashboard. Mirrors AdminLayout's structure (noindex utility pages,
// same input/button classes) so both areas feel like one product.

templ AccountLayout(title, nonce, email string) {
	<!DOCTYPE html>
	<html lang="fr" class="h-full">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } · Congopro</title>
			<meta name="robots" content="noindex,nofollow"/>
			<meta name="color-scheme" content="light dark"/>
			<script nonce={ nonce }>
				(function () {
					try {
						var t = localStorage.getItem("cp_theme");
						if (t !== "dark" && t !== "light") t = "light";
						document.documentElement.dataset.theme = t;
					} catch (e) {}
				})();
			</script>
			<link rel="preload" href="/fonts/inter-400.woff2" as="font" type="font/woff2" crossorigin="anonymous"/>
			<link rel="preload" href="/fonts/sora-600.woff2" as="font" type="font/woff2" crossorigin="anonymous"/>
			<link rel="stylesheet" href={ "/css/style.min.css?h=" + CSSVersion }/>
		</head>
		<body class="bg-white text-gray-900 antialiased min-h-full flex flex-col">
			if email != "" {
				<header class="bg-white border-b border-gray-200">
					<div class="max-w-3xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
						<a href="/" class="font-sora font-semibold text-gray-900">Congopro</a>
						<div class="flex items-center gap-4 text-sm">
							<span class="text-gray-500">{ email }</span>
							<form method="post" action="/account/logout">
								<button type="submit" class="text-gray-500 hover:text-gray-900">Déconnexion</button>
							</form>
						</div>
					</div>
				</header>
			}
			<main class="flex-1 w-full max-w-3xl mx-auto px-4 sm:px-6 py-8">
				{ children... }
			</main>
			@SiteFooter()
		</body>
	</html>
}

templ AccountLoginPage(nonce, errorMsg, next string) {
	@AccountLayout("Connexion", nonce, "") {
		<div class="max-w-sm mx-auto mt-16">
			<h1 class="text-xl font-sora font-semibold text-gray-900 mb-2">Mon compte</h1>
			<p class="text-sm text-gray-500 mb-6">Recevez un code de connexion par email — pas de mot de passe.</p>
			if errorMsg != "" {
				<div class="mb-4 rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3">
					{ errorMsg }
				</div>
			}
			<form method="post" action="/account/login" class="space-y-4">
				if next != "" {
					<input type="hidden" name="next" value={ next }/>
				}
				<div>
					<label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email</label>
					<input
						type="email"
						id="email"
						name="email"
						required
						autocomplete="username"
						class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
					/>
				</div>
				<button
					type="submit"
					class="w-full rounded-lg bg-gray-900 text-white text-sm font-medium py-2.5 hover:bg-gray-800 transition-colors"
				>
					Recevoir mon code
				</button>
			</form>
		</div>
	}
}

templ AccountVerifyPage(nonce, email, errorMsg, next string) {
	@AccountLayout("Vérification", nonce, "") {
		<div class="max-w-sm mx-auto mt-16">
			<h1 class="text-xl font-sora font-semibold text-gray-900 mb-2">Code envoyé</h1>
			<p class="text-sm text-gray-500 mb-6">
				Saisissez le code à 6 chiffres envoyé à
				<span class="font-medium text-gray-700">{ email }</span>.
				Il est valable 10&nbsp;minutes.
			</p>
			if errorMsg != "" {
				<div class="mb-4 rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3">
					{ errorMsg }
				</div>
			}
			<form method="post" action="/account/verify" class="space-y-4">
				<input type="hidden" name="email" value={ email }/>
				if next != "" {
					<input type="hidden" name="next" value={ next }/>
				}
				<div>
					<label for="code" class="block text-sm font-medium text-gray-700 mb-1">Code (6 chiffres)</label>
					<input
						type="text"
						id="code"
						name="code"
						inputmode="numeric"
						pattern="[0-9]{6}"
						maxlength="6"
						required
						autocomplete="one-time-code"
						class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm tracking-widest focus:outline-none focus:ring-2 focus:ring-blue-500"
					/>
				</div>
				<button
					type="submit"
					class="w-full rounded-lg bg-gray-900 text-white text-sm font-medium py-2.5 hover:bg-gray-800 transition-colors"
				>
					Me connecter
				</button>
			</form>
			<p class="mt-4 text-xs text-gray-400">
				Pas reçu ? Un nouveau code peut être demandé après 1&nbsp;minute —
				<a href="/account/login" class="underline hover:text-gray-600">renvoyer</a>.
			</p>
		</div>
	}
}

templ AccountDashboard(nonce string, cust *customers.Customer, myClaims []claims.Claim) {
	{{
		email := ""
		if cust != nil {
			email = cust.Email
		}
	}}
	@AccountLayout("Mon compte", nonce, email) {
		<div class="max-w-lg mt-8">
			<h1 class="text-xl font-sora font-semibold text-gray-900 mb-2">Mon compte</h1>
			<p class="text-sm text-gray-500 mb-6">Connecté en tant que { email }.</p>

			if len(myClaims) > 0 {
				<h2 class="text-base font-sora font-semibold text-gray-900 mt-8 mb-3">Mes réclamations</h2>
				<div class="rounded-lg border border-gray-200 bg-white divide-y divide-gray-100">
					for _, cl := range myClaims {
						<div class="px-4 py-3 flex items-center justify-between gap-3">
							<div class="min-w-0">
								<p class="text-sm font-medium text-gray-900 truncate">{ cl.CompanyName }</p>
								<p class="text-xs text-gray-400 mt-0.5">{ cl.CreatedAt.Format("02/01/2006") }</p>
							</div>
							@claimStatusBadge(cl.Status)
						</div>
					}
				</div>
			} else {
				<div class="rounded-lg border border-gray-200 bg-gray-50 px-4 py-5 text-sm text-gray-500">
					Vous n'avez pas encore réclamé d'entreprise. Ouvrez une fiche entreprise puis
					«&nbsp;Réclamer cette entreprise&nbsp;» pour la rattacher à votre compte.
				</div>
			}

			<form method="post" action="/account/logout" class="mt-6">
				<button
					type="submit"
					class="rounded-lg border border-gray-300 text-gray-700 text-sm font-medium px-4 py-2 hover:bg-gray-50 transition-colors"
				>
					Se déconnecter
				</button>
			</form>
		</div>
	}
}

templ AccountClaimPage(nonce, email, companySlug, companyName string, state claims.CompanyState, errorMsg string) {
	@AccountLayout("Réclamer une entreprise", nonce, email) {
		<div class="max-w-lg mt-8">
			<h1 class="text-xl font-sora font-semibold text-gray-900 mb-1">Réclamer une entreprise</h1>
			<p class="text-sm text-gray-500 mb-6">
				{ companyName } — rattachée à <span class="font-medium text-gray-700">{ email }</span>
			</p>

			if errorMsg != "" {
				<div class="mb-4 rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3">
					{ errorMsg }
				</div>
			}

			if state.Claimed {
				<div class="rounded-lg bg-green-50 border border-green-200 text-green-700 text-sm px-4 py-3">
					if state.ClaimedByMe {
						Cette entreprise est déjà rattachée à votre compte.
					} else {
						Cette entreprise est déjà revendiquée par un autre compte vérifié.
					}
				</div>
			} else if state.Pending {
				<div class="rounded-lg bg-yellow-50 border border-yellow-200 text-yellow-700 text-sm px-4 py-3">
					if state.PendingByMe {
						Votre réclamation est en cours d'examen par notre équipe. Vous recevrez un email à la décision.
					} else {
						Une réclamation est déjà en cours pour cette entreprise.
					}
				</div>
			} else {
				<form method="post" action="/account/claim" class="space-y-4">
					<input type="hidden" name="company_slug" value={ companySlug }/>
					<div>
						<label for="relationship" class="block text-sm font-medium text-gray-700 mb-1">Votre relation avec cette entreprise</label>
						<select
							id="relationship"
							name="relationship"
							required
							class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
						>
							<option value="owner">Propriétaire</option>
							<option value="manager">Gérant</option>
							<option value="employee">Employé</option>
							<option value="other">Autre</option>
						</select>
					</div>
					<div>
						<label for="phone" class="block text-sm font-medium text-gray-700 mb-1">Téléphone (facultatif)</label>
						<input
							type="tel"
							id="phone"
							name="phone"
							autocomplete="tel"
							class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
						/>
					</div>
					<div>
						<label for="evidence" class="block text-sm font-medium text-gray-700 mb-1">
							Justification — pourquoi cette entreprise vous appartient-elle ?
						</label>
						<textarea
							id="evidence"
							name="evidence"
							rows="5"
							required
							minlength="20"
							maxlength="4000"
							class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
						></textarea>
						<p class="text-xs text-gray-400 mt-1">Au moins 20 caractères. Notre équipe vérifie chaque demande.</p>
					</div>
					<button
						type="submit"
						class="w-full rounded-lg bg-gray-900 text-white text-sm font-medium py-2.5 hover:bg-gray-800 transition-colors"
					>
						Envoyer ma réclamation
					</button>
				</form>
			}
		</div>
	}
}

templ claimStatusBadge(status string) {
	{{ label, cls := claimStatusBadgeStyle(status) }}
	<span class={ "inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium " + cls }>{ label }</span>
}

func claimStatusBadgeStyle(status string) (string, string) {
	switch status {
	case "approved":
		return "Approuvée", "bg-green-50 text-green-700 border border-green-200"
	case "rejected":
		return "Refusée", "bg-red-50 text-red-700 border border-red-200"
	default:
		return "En attente", "bg-yellow-50 text-yellow-700 border border-yellow-200"
	}
}

func claimRelationshipLabel(r string) string {
	switch r {
	case "owner":
		return "Propriétaire"
	case "manager":
		return "Gérant"
	case "employee":
		return "Employé"
	default:
		return "Autre"
	}
}


templ AccountPromotePage(nonce, email string, eligible []promotions.EligibleCompany, current []promotions.Promotion, priceStr string, ok, canceled bool) {
	@AccountLayout("Mise en avant", nonce, email) {
		<div class="max-w-lg mt-8">
			<h1 class="text-xl font-sora font-semibold text-gray-900 mb-1">Mise en avant</h1>
			<p class="text-sm text-gray-500 mb-6">
				Votre entreprise apparaît avec un badge «&nbsp;Promu&nbsp;» sur sa fiche et dans les résultats.
				if priceStr != "" {
					{ priceStr }, sans engagement — résiliable à tout moment.
				}
			</p>

			if ok {
				<div class="mb-4 rounded-lg bg-green-50 border border-green-200 text-green-700 text-sm px-4 py-3">
					Paiement confirmé — votre mise en avant est active (l'activation peut prendre quelques secondes).
				</div>
			}
			if canceled {
				<div class="mb-4 rounded-lg bg-yellow-50 border border-yellow-200 text-yellow-700 text-sm px-4 py-3">
					Paiement annulé — aucun montant n'a été prélevé.
				</div>
			}

			if len(current) > 0 {
				<h2 class="text-base font-sora font-semibold text-gray-900 mt-6 mb-3">Mes mises en avant</h2>
				<div class="rounded-lg border border-gray-200 bg-white divide-y divide-gray-100 mb-6">
					for _, pr := range current {
						<div class="px-4 py-3 flex items-center justify-between gap-3">
							<div class="min-w-0">
								<p class="text-sm font-medium text-gray-900 truncate">{ pr.CompanyName }</p>
								if pr.CurrentPeriodEnd != nil && pr.Status != "canceled" {
									<p class="text-xs text-gray-400 mt-0.5">Renouvellement le { pr.CurrentPeriodEnd.Format("02/01/2006") }</p>
								}
							</div>
							@promoStatusBadge(pr.Status)
						</div>
					}
				</div>
			}

			<h2 class="text-base font-sora font-semibold text-gray-900 mt-6 mb-3">Promouvoir une entreprise</h2>
			if len(eligible) > 0 {
				<div class="rounded-lg border border-gray-200 bg-white divide-y divide-gray-100">
					for _, co := range eligible {
						{{ citySuffix := ""; if co.City != "" { citySuffix = " · " + co.City } }}
						<div class="px-4 py-3 flex items-center justify-between gap-3">
							<div class="min-w-0">
								<p class="text-sm font-medium text-gray-900 truncate">{ co.Name }</p>
								if co.Activity != "" || co.City != "" {
									<p class="text-xs text-gray-400 mt-0.5 truncate">{ co.Activity + citySuffix }</p>
								}
							</div>
							<form method="post" action="/account/promote" class="shrink-0">
								<input type="hidden" name="company_slug" value={ co.NameSeo }/>
								<button
									type="submit"
									class="rounded-lg bg-gray-900 hover:bg-gray-800 text-white text-xs font-medium px-3.5 py-2 transition-colors"
								>
									Promouvoir
								</button>
							</form>
						</div>
					}
				</div>
				<p class="mt-3 text-xs text-gray-400">Le paiement est traité par Stripe. Aucune donnée bancaire ne transite par Congopro.</p>
			} else {
				<div class="rounded-lg border border-gray-200 bg-gray-50 px-4 py-5 text-sm text-gray-500">
					Aucune entreprise éligible. Pour promouvoir une entreprise, réclamez-la d'abord depuis sa fiche
					(<span class="text-gray-700">«&nbsp;Réclamer&nbsp;»</span>) et attendez la validation de notre équipe.
				</div>
			}
		</div>
	}
}

func promoStatusBadgeStyle(status string) (string, string) {
	switch status {
	case "active":
		return "Active", "bg-green-50 text-green-700 border border-green-200"
	case "past_due":
		return "Paiement en attente", "bg-yellow-50 text-yellow-700 border border-yellow-200"
	case "pending":
		return "En cours", "bg-blue-50 text-blue-700 border border-blue-200"
	default:
		return "Résiliée", "bg-gray-100 text-gray-500 border border-gray-200"
	}
}

templ promoStatusBadge(status string) {
	{{ label, cls := promoStatusBadgeStyle(status) }}
	<span class={ "inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium whitespace-nowrap " + cls }>{ label }</span>
}
