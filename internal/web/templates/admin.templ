package templates

import (
	"fmt"
	"net/url"
	"strconv"

	"congopro-bridge/internal/ads"
	"congopro-bridge/internal/claims"
)

// AdminAdRow is one row of the ads campaign list.
type AdminAdRow struct {
	ID          string
	Title       string
	Placement   string
	Status      string
	Period      string
	Weight      int
	SoldByEmail string
	UpdatedAt   string
}

// StaffOption backs the sold-by select.
type StaffOption struct {
	ID    string
	Label string
}

// AdminAdFormData backs the ads new/edit forms.
type AdminAdFormData struct {
	ID            string
	Title         string
	Description   string
	URL           string
	DisplayURL    string
	Label         string
	Color         string
	PeriodStart   string
	PeriodEnd     string
	Weight        string
	Placement     string
	Keywords      string // one per line
	Status        string
	SoldByUserID  string
	CustomerEmail string
	Price         string
	Currency      string
}

// AdminCompanyRow is one row in the admin companies list.
type AdminCompanyRow struct {
	ID        string
	Name      string
	City      string
	Country   string
	Status    string
	UpdatedAt string
}

// AdminCompanyFormData backs both the "new company" and "edit company" forms.
type AdminCompanyFormData struct {
	ID            string
	Name          string
	NameSeo       string
	Activity      string
	City          string
	Country       string
	Description   string
	Slogan        string
	Website       string
	Email         string
	Phone         string
	AddressLine1  string
	AddressLine2  string
	Twitter       string
	Facebook      string
	LinkedIn      string
	Instagram     string
	TikTok        string
	Whatsapp      string
	Youtube       string
	StatsShow     bool
	Status        string
	Lon           string
	Lat           string
}

// AdminLayout is the internal-tool counterpart to Layout — no analytics, no
// cookie banner, no public SEO metadata (noindex instead). Deliberately
// separate from the public Layout rather than a shared component with flags,
// since the two pages have almost nothing in common besides the stylesheet.
templ AdminLayout(title, nonce, userName string) {
	<!DOCTYPE html>
	<html lang="fr" class="h-full">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } · Congopro Admin</title>
			<meta name="robots" content="noindex,nofollow"/>
			<link rel="stylesheet" href="/css/style.min.css"/>
		</head>
		<body class="bg-gray-50 text-gray-900 antialiased min-h-full">
			if userName != "" {
				<header class="bg-white border-b border-gray-200">
					<div class="max-w-5xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
						<div class="flex items-center gap-5">
							<a href="/admin" class="font-sora font-semibold text-gray-900">Congopro Admin</a>
							<nav class="flex items-center gap-4 text-sm text-gray-600">
								<a href="/admin" class="hover:text-gray-900">Entreprises</a>
								<a href="/admin/claims" class="hover:text-gray-900">Réclamations</a>
								<a href="/admin/ads" class="hover:text-gray-900">Publicités</a>
							</nav>
						</div>
						<div class="flex items-center gap-4 text-sm">
							<span class="text-gray-500">{ userName }</span>
							<form method="post" action="/admin/logout">
								<button type="submit" class="text-gray-500 hover:text-gray-900">Déconnexion</button>
							</form>
						</div>
					</div>
				</header>
			}
			<main class="max-w-5xl mx-auto px-4 sm:px-6 py-8">
				{ children... }
			</main>
		</body>
	</html>
}

templ AdminLoginPage(nonce, errorMsg string) {
	@AdminLayout("Connexion", nonce, "") {
		<div class="max-w-sm mx-auto mt-16">
			<h1 class="text-xl font-sora font-semibold text-gray-900 mb-6">Connexion staff</h1>
			if errorMsg != "" {
				<div class="mb-4 rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3">
					{ errorMsg }
				</div>
			}
			<form method="post" action="/admin/login" class="space-y-4">
				<div>
					<label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email</label>
					<input
						type="email"
						id="email"
						name="email"
						required
						autocomplete="username"
						class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
					/>
				</div>
				<div>
					<label for="password" class="block text-sm font-medium text-gray-700 mb-1">Mot de passe</label>
					<input
						type="password"
						id="password"
						name="password"
						required
						autocomplete="current-password"
						class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
					/>
				</div>
				<div>
					<label for="totp_code" class="block text-sm font-medium text-gray-700 mb-1">Code d'authentification (6 chiffres)</label>
					<input
						type="text"
						id="totp_code"
						name="totp_code"
						inputmode="numeric"
						pattern="[0-9]{6}"
						maxlength="6"
						required
						autocomplete="one-time-code"
						class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm tracking-widest focus:outline-none focus:ring-2 focus:ring-blue-500"
					/>
				</div>
				<button
					type="submit"
					class="w-full rounded-lg bg-gray-900 text-white text-sm font-medium py-2.5 hover:bg-gray-800 transition-colors"
				>
					Se connecter
				</button>
			</form>
		</div>
	}
}

templ AdminCompaniesList(nonce, userName, query string, companies []AdminCompanyRow, page int, hasNext bool) {
	@AdminLayout("Entreprises", nonce, userName) {
		<div class="flex items-center justify-between mb-6">
			<h1 class="text-xl font-sora font-semibold text-gray-900">Entreprises</h1>
			<a
				href="/admin/companies/new"
				class="rounded-lg bg-gray-900 text-white text-sm font-medium px-4 py-2 hover:bg-gray-800 transition-colors"
			>
				+ Nouvelle entreprise
			</a>
		</div>
		<form method="get" action="/admin" class="mb-4">
			<input
				type="search"
				name="q"
				value={ query }
				placeholder="Rechercher par nom…"
				class="w-full max-w-sm rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
			/>
		</form>
		<div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
			<table class="w-full text-sm">
				<thead class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wide">
					<tr>
						<th class="text-left px-4 py-2.5 font-medium">Nom</th>
						<th class="text-left px-4 py-2.5 font-medium">Ville</th>
						<th class="text-left px-4 py-2.5 font-medium">Pays</th>
						<th class="text-left px-4 py-2.5 font-medium">Statut</th>
						<th class="text-left px-4 py-2.5 font-medium">Mis à jour</th>
						<th class="px-4 py-2.5"></th>
					</tr>
				</thead>
				<tbody class="divide-y divide-gray-100">
					for _, c := range companies {
						<tr class="hover:bg-gray-50">
							<td class="px-4 py-2.5 font-medium text-gray-900">{ c.Name }</td>
							<td class="px-4 py-2.5 text-gray-600">{ c.City }</td>
							<td class="px-4 py-2.5 text-gray-600">{ c.Country }</td>
							<td class="px-4 py-2.5">
								@statusBadge(c.Status)
							</td>
							<td class="px-4 py-2.5 text-gray-500">{ c.UpdatedAt }</td>
							<td class="px-4 py-2.5 text-right">
								<a href={ templ.URL("/admin/companies/" + c.ID + "/edit") } class="text-blue-600 hover:underline">
									Modifier
								</a>
							</td>
						</tr>
					}
					if len(companies) == 0 {
						<tr>
							<td colspan="6" class="px-4 py-8 text-center text-gray-500">Aucune entreprise trouvée.</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		<div class="flex items-center justify-between mt-4 text-sm">
			<span class="text-gray-500">Page { fmt.Sprint(page) }</span>
			<div class="flex gap-2">
				if page > 1 {
					<a href={ templ.URL(pageURL(query, page-1)) } class="px-3 py-1.5 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-50">← Précédent</a>
				}
				if hasNext {
					<a href={ templ.URL(pageURL(query, page+1)) } class="px-3 py-1.5 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-50">Suivant →</a>
				}
			</div>
		</div>
	}
}

func pageURL(query string, page int) string {
	u := "/admin?page=" + strconv.Itoa(page)
	if query != "" {
		u += "&q=" + url.QueryEscape(query)
	}
	return u
}

templ statusBadge(status string) {
	switch status {
		case "published":
			<span class="inline-flex items-center text-xs font-medium px-2 py-0.5 rounded-full bg-green-50 text-green-700">Publié</span>
		case "draft":
			<span class="inline-flex items-center text-xs font-medium px-2 py-0.5 rounded-full bg-gray-100 text-gray-600">Brouillon</span>
		case "disputed":
			<span class="inline-flex items-center text-xs font-medium px-2 py-0.5 rounded-full bg-amber-50 text-amber-700">Litige</span>
		default:
			<span class="inline-flex items-center text-xs font-medium px-2 py-0.5 rounded-full bg-gray-100 text-gray-600">{ status }</span>
	}
}

templ AdminCompanyForm(nonce, userName string, form AdminCompanyFormData, isEdit bool, errorMsg string) {
	@AdminLayout(formTitle(isEdit), nonce, userName) {
		<div class="max-w-2xl">
			<div class="flex items-center justify-between mb-6">
				<h1 class="text-xl font-sora font-semibold text-gray-900">{ formTitle(isEdit) }</h1>
				<a href="/admin" class="text-sm text-gray-500 hover:text-gray-900">← Retour à la liste</a>
			</div>
			if errorMsg != "" {
				<div class="mb-4 rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3">
					{ errorMsg }
				</div>
			}
			<form
				method="post"
				action={ templ.URL(formAction(isEdit, form.ID)) }
				class="bg-white rounded-lg border border-gray-200 p-6 space-y-5"
			>
				<div class="grid grid-cols-2 gap-4">
					@field("Nom *", "name", "text", form.Name, true)
					@field("Slug (name_seo)", "name_seo", "text", form.NameSeo, false)
					@field("Activité", "activity", "text", form.Activity, false)
					@field("Ville", "city", "text", form.City, false)
					@field("Pays", "country", "text", form.Country, false)
					<div>
						<label for="status" class="block text-sm font-medium text-gray-700 mb-1">Statut</label>
						<select
							id="status"
							name="status"
							class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
						>
							<option value="draft" selected?={ form.Status == "draft" }>Brouillon</option>
							<option value="published" selected?={ form.Status == "published" }>Publié</option>
							<option value="disputed" selected?={ form.Status == "disputed" }>Litige</option>
						</select>
					</div>
				</div>
				<div>
					<label for="slogan" class="block text-sm font-medium text-gray-700 mb-1">Slogan</label>
					<input
						type="text"
						id="slogan"
						name="slogan"
						value={ form.Slogan }
						class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
					/>
				</div>
				<div>
					<label for="description" class="block text-sm font-medium text-gray-700 mb-1">Description</label>
					<textarea
						id="description"
						name="description"
						rows="4"
						class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
					>{ form.Description }</textarea>
				</div>
				<div class="grid grid-cols-2 gap-4">
					@field("Site web", "website", "url", form.Website, false)
					@field("Email", "email", "email", form.Email, false)
					@field("Téléphone", "phone", "text", form.Phone, false)
					@field("Adresse", "address_line_1", "text", form.AddressLine1, false)
					@field("Complément d'adresse", "address_line_2", "text", form.AddressLine2, false)
				</div>
				<div class="grid grid-cols-2 gap-4">
					@field("Twitter/X", "twitter", "text", form.Twitter, false)
					@field("Facebook", "facebook", "text", form.Facebook, false)
					@field("LinkedIn", "linkedin", "text", form.LinkedIn, false)
					@field("Instagram", "instagram", "text", form.Instagram, false)
					@field("TikTok", "tiktok", "text", form.TikTok, false)
					@field("WhatsApp", "whatsapp", "text", form.Whatsapp, false)
					@field("YouTube", "youtube", "text", form.Youtube, false)
				</div>
				<div class="grid grid-cols-2 gap-4">
					@field("Longitude", "lon", "text", form.Lon, false)
					@field("Latitude", "lat", "text", form.Lat, false)
				</div>
				<div class="flex items-center gap-2">
					<input
						type="checkbox"
						id="stats_show"
						name="stats_show"
						checked?={ form.StatsShow }
						class="rounded border-gray-300"
					/>
					<label for="stats_show" class="text-sm text-gray-700">Afficher les statistiques publiquement</label>
				</div>
				<div class="pt-2">
					<button
						type="submit"
						class="rounded-lg bg-gray-900 text-white text-sm font-medium px-5 py-2.5 hover:bg-gray-800 transition-colors"
					>
						Enregistrer
					</button>
				</div>
			</form>
		</div>
	}
}

templ field(label, name, inputType, value string, required bool) {
	<div>
		<label for={ name } class="block text-sm font-medium text-gray-700 mb-1">{ label }</label>
		<input
			type={ inputType }
			id={ name }
			name={ name }
			value={ value }
			required?={ required }
			class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
		/>
	</div>
}

func formTitle(isEdit bool) string {
	if isEdit {
		return "Modifier l'entreprise"
	}
	return "Nouvelle entreprise"
}

func formAction(isEdit bool, id string) string {
	if isEdit {
		return "/admin/companies/" + id + "/edit"
	}
	return "/admin/companies/new"
}

templ AdminClaimsList(nonce, userName, statusFilter string, list []claims.Claim) {
	@AdminLayout("Réclamations", nonce, userName) {
		<div class="flex items-center justify-between mb-6">
			<h1 class="text-xl font-sora font-semibold text-gray-900">Réclamations</h1>
			<nav class="flex items-center gap-1 text-sm">
				@claimFilterTab(statusFilter, "", "Toutes")
				@claimFilterTab(statusFilter, "pending", "En attente")
				@claimFilterTab(statusFilter, "approved", "Approuvées")
				@claimFilterTab(statusFilter, "rejected", "Refusées")
			</nav>
		</div>
		<div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
			if len(list) == 0 {
				<div class="px-4 py-8 text-sm text-gray-500 text-center">
					Aucune réclamation { claimFilterLabel(statusFilter) }.
				</div>
			} else {
				<table class="w-full text-sm">
					<thead>
						<tr class="text-left text-xs text-gray-500 uppercase border-b border-gray-200 bg-gray-50">
							<th class="px-4 py-2.5 font-medium">Entreprise</th>
							<th class="px-4 py-2.5 font-medium">Demandeur</th>
							<th class="px-4 py-2.5 font-medium">Justification</th>
							<th class="px-4 py-2.5 font-medium">Statut</th>
							<th class="px-4 py-2.5 font-medium"></th>
						</tr>
					</thead>
					<tbody class="divide-y divide-gray-100">
						for _, cl := range list {
							<tr class="align-top">
								<td class="px-4 py-3">
									<a href={ templ.URL("/company/" + cl.CompanyNameSeo) } class="font-medium text-gray-900 hover:underline">
										{ cl.CompanyName }
									</a>
									<p class="text-xs text-gray-400 mt-0.5">{ cl.CreatedAt.Format("02/01/2006 15:04") }</p>
								</td>
								<td class="px-4 py-3">
									<p class="text-gray-900">{ cl.ClaimantEmail }</p>
									if cl.ContactPhone != "" {
										<p class="text-xs text-gray-500 mt-0.5">{ cl.ContactPhone }</p>
									}
									<p class="text-xs text-gray-500 mt-0.5">{ claimRelationshipLabel(cl.Relationship) }</p>
								</td>
								<td class="px-4 py-3 text-gray-600 max-w-md">
									<p class="whitespace-pre-line">{ cl.Evidence }</p>
									if cl.AdminNote != "" {
										<p class="text-xs text-gray-400 mt-1.5">Note : { cl.AdminNote }</p>
									}
								</td>
								<td class="px-4 py-3">@claimStatusBadge(cl.Status)</td>
								<td class="px-4 py-3">
									if cl.Status == "pending" {
										<form method="post" class="space-y-1.5 w-44">
											<input
												type="text"
												name="note"
												placeholder="Note (facultatif)"
												class="w-full rounded-md border border-gray-200 px-2 py-1.5 text-xs focus:outline-none focus:ring-1 focus:ring-blue-500"
											/>
											<div class="flex gap-1.5">
												<button
													type="submit"
													formaction={ templ.SafeURL("/admin/claims/" + cl.ID + "/approve") }
													class="flex-1 rounded-md bg-green-600 hover:bg-green-700 text-white text-xs font-medium py-1.5 transition-colors"
												>
													Approuver
												</button>
												<button
													type="submit"
													formaction={ templ.SafeURL("/admin/claims/" + cl.ID + "/reject") }
													class="flex-1 rounded-md bg-white border border-red-200 hover:bg-red-50 text-red-600 text-xs font-medium py-1.5 transition-colors"
												>
													Refuser
												</button>
											</div>
										</form>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
		</div>
	}
}

templ claimFilterTab(current, value, label string) {
	{{ active := current == value }}
	<a
		href={ templ.URL(claimFilterHref(value)) }
		class={ "px-3 py-1.5 rounded-full transition-colors " + claimTabClass(active) }
	>
		{ label }
	</a>
}

func claimFilterHref(value string) string {
	if value == "" {
		return "/admin/claims"
	}
	return "/admin/claims?status=" + value
}

func claimTabClass(active bool) string {
	if active {
		return "bg-gray-900 text-white"
	}
	return "text-gray-600 hover:bg-gray-100"
}

func claimFilterLabel(statusFilter string) string {
	switch statusFilter {
	case "pending":
		return "en attente"
	case "approved":
		return "approuvée"
	case "rejected":
		return "refusée"
	default:
		return ""
	}
}

templ AdminAdsList(nonce, userName, statusFilter string, list []AdminAdRow, settings ads.Settings) {
	@AdminLayout("Publicités", nonce, userName) {
		<div class="flex items-center justify-between mb-6">
			<h1 class="text-xl font-sora font-semibold text-gray-900">Publicités</h1>
			<a
				href="/admin/ads/new"
				class="rounded-lg bg-gray-900 hover:bg-gray-800 text-white text-sm font-medium px-4 py-2 transition-colors"
			>
				+ Nouvelle campagne
			</a>
		</div>

		<form method="post" action="/admin/ads/settings" class="bg-white rounded-lg border border-gray-200 p-4 mb-6 flex flex-wrap items-end gap-4">
			<div>
				<p class="text-xs text-gray-500 uppercase font-medium mb-2">Réglages globaux</p>
				<label class="flex items-center gap-2 text-sm text-gray-700">
					<input type="checkbox" name="active" checked?={ settings.Active } class="rounded border-gray-300"/>
					Système actif
				</label>
			</div>
			<div>
				<label for="rotation_sec" class="block text-xs text-gray-500 mb-1">Rotation (s)</label>
				<input
					type="number" id="rotation_sec" name="rotation_sec" min="1" max="120"
					value={ strconv.Itoa(settings.RotationSec) }
					class="w-24 rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
				/>
			</div>
			<div>
				<label for="max_per_page" class="block text-xs text-gray-500 mb-1">Max / page</label>
				<input
					type="number" id="max_per_page" name="max_per_page" min="1" max="3"
					value={ strconv.Itoa(settings.MaxPerPage) }
					class="w-24 rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
				/>
			</div>
			<button type="submit" class="rounded-lg border border-gray-300 hover:bg-gray-50 text-gray-700 text-sm font-medium px-4 py-2 transition-colors">
				Enregistrer
			</button>
		</form>

		<nav class="flex items-center gap-1 text-sm mb-4">
			@adsFilterTab(statusFilter, "", "Toutes")
			@adsFilterTab(statusFilter, "active", "Actives")
			@adsFilterTab(statusFilter, "draft", "Brouillons")
			@adsFilterTab(statusFilter, "paused", "En pause")
			@adsFilterTab(statusFilter, "expired", "Expirées")
		</nav>

		<div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
			if len(list) == 0 {
				<div class="px-4 py-8 text-sm text-gray-500 text-center">Aucune campagne.</div>
			} else {
				<table class="w-full text-sm">
					<thead>
						<tr class="text-left text-xs text-gray-500 uppercase border-b border-gray-200 bg-gray-50">
							<th class="px-4 py-2.5 font-medium">Campagne</th>
							<th class="px-4 py-2.5 font-medium">Emplacement</th>
							<th class="px-4 py-2.5 font-medium">Période</th>
							<th class="px-4 py-2.5 font-medium">Statut</th>
							<th class="px-4 py-2.5 font-medium">Vendu par</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-gray-100">
						for _, row := range list {
							<tr class="hover:bg-gray-50">
								<td class="px-4 py-3">
									<a href={ templ.URL("/admin/ads/" + row.ID + "/edit") } class="font-medium text-gray-900 hover:underline">{ row.Title }</a>
									<p class="text-xs text-gray-400 mt-0.5">{ row.ID }</p>
								</td>
								<td class="px-4 py-3 text-gray-600">{ adPlacementLabel(row.Placement) }</td>
								<td class="px-4 py-3 text-gray-600">{ row.Period }</td>
								<td class="px-4 py-3">@adStatusBadge(row.Status)</td>
								<td class="px-4 py-3 text-gray-600">{ row.SoldByEmail }</td>
							</tr>
						}
					</tbody>
				</table>
			}
		</div>
	}
}

templ adsFilterTab(current, value, label string) {
	{{ active := current == value }}
	<a
		href={ templ.URL(adsFilterHref(value)) }
		class={ "px-3 py-1.5 rounded-full transition-colors " + claimTabClass(active) }
	>
		{ label }
	</a>
}

func adsFilterHref(value string) string {
	if value == "" {
		return "/admin/ads"
	}
	return "/admin/ads?status=" + value
}

func adPlacementLabel(p string) string {
	switch p {
	case "homepage":
		return "Accueil"
	case "search_results":
		return "Résultats"
	default:
		return "Résultats"
	}
}

func adStatusBadgeStyle(status string) (string, string) {
	switch status {
	case "active":
		return "Active", "bg-green-50 text-green-700 border border-green-200"
	case "paused":
		return "En pause", "bg-yellow-50 text-yellow-700 border border-yellow-200"
	case "expired":
		return "Expirée", "bg-gray-100 text-gray-500 border border-gray-200"
	default:
		return "Brouillon", "bg-blue-50 text-blue-700 border border-blue-200"
	}
}

templ adStatusBadge(status string) {
	{{ label, cls := adStatusBadgeStyle(status) }}
	<span class={ "inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium " + cls }>{ label }</span>
}

templ AdminAdForm(nonce, userName string, form AdminAdFormData, isNew bool, errorMsg string, staff []StaffOption, labelValues []string) {
	@AdminLayout(adFormTitle(isNew), nonce, userName) {
		<div class="max-w-2xl">
			<div class="flex items-center justify-between mb-6">
				<h1 class="text-xl font-sora font-semibold text-gray-900">
					if isNew {
						<span>Nouvelle campagne</span>
					} else {
						<span>Modifier : { form.Title }</span>
					}
				</h1>
				<a href="/admin/ads" class="text-sm text-gray-500 hover:text-gray-900">← Retour</a>
			</div>
			if errorMsg != "" {
				<div class="mb-4 rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3">{ errorMsg }</div>
			}
			<form method="post" class="space-y-4 bg-white rounded-lg border border-gray-200 p-5">
				if isNew {
					@adField("Identifiant (slug unique)", "id", "text", form.ID, true, "ex : rawbank-homepage-2026")
				}
				@adField("Titre", "title", "text", form.Title, true, "")
				@adField("Description", "description", "text", form.Description, false, "")
				@adField("URL de destination (https)", "url", "url", form.URL, true, "")
				@adField("URL affichée", "display_url", "text", form.DisplayURL, false, "ex : rawbank.cd")

				<div class="grid grid-cols-2 gap-4">
					<div>
						<label for="label" class="block text-sm font-medium text-gray-700 mb-1">Label</label>
						<input list="ad-label-presets" type="text" id="label" name="label" value={ form.Label }
							class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"/>
						<datalist id="ad-label-presets">
							for _, lv := range labelValues {
								<option value={ lv }></option>
							}
						</datalist>
					</div>
					<div>
						<label for="color" class="block text-sm font-medium text-gray-700 mb-1">Couleur d'accent</label>
						<input type="text" id="color" name="color" value={ form.Color } placeholder="#1a73e8"
							class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"/>
					</div>
				</div>

				<div class="grid grid-cols-3 gap-4">
					<div>
						<label for="period_start" class="block text-sm font-medium text-gray-700 mb-1">Début</label>
						<input type="date" id="period_start" name="period_start" value={ form.PeriodStart }
							class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"/>
					</div>
					<div>
						<label for="period_end" class="block text-sm font-medium text-gray-700 mb-1">Fin (incluse)</label>
						<input type="date" id="period_end" name="period_end" value={ form.PeriodEnd }
							class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"/>
					</div>
					<div>
						<label for="weight" class="block text-sm font-medium text-gray-700 mb-1">Poids</label>
						<input type="number" id="weight" name="weight" min="0" max="100" value={ form.Weight }
							class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"/>
					</div>
				</div>

				<div class="grid grid-cols-2 gap-4">
					<div>
						<label for="placement" class="block text-sm font-medium text-gray-700 mb-1">Emplacement</label>
						<select id="placement" name="placement"
							class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
							<option value="search_results" selected?={ form.Placement == "search_results" }>Résultats de recherche</option>
							<option value="homepage" selected?={ form.Placement == "homepage" }>Accueil</option>
						</select>
					</div>
					<div>
						<label for="status" class="block text-sm font-medium text-gray-700 mb-1">Statut</label>
						<select id="status" name="status"
							class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
							<option value="draft" selected?={ form.Status == "draft" }>Brouillon</option>
							<option value="active" selected?={ form.Status == "active" }>Active</option>
							<option value="paused" selected?={ form.Status == "paused" }>En pause</option>
							<option value="expired" selected?={ form.Status == "expired" }>Expirée</option>
						</select>
					</div>
				</div>

				<div>
					<label for="keywords" class="block text-sm font-medium text-gray-700 mb-1">Mots-clés (un par ligne — vide = toutes les requêtes)</label>
					<textarea id="keywords" name="keywords" rows="4" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-blue-500">{ form.Keywords }</textarea>
				</div>

				<div class="border-t border-gray-100 pt-4">
					<p class="text-xs text-gray-500 uppercase font-medium mb-3">Attribution commerciale</p>
					<div class="grid grid-cols-2 gap-4">
						<div>
							<label for="sold_by" class="block text-sm font-medium text-gray-700 mb-1">Vendu par</label>
							<select id="sold_by" name="sold_by"
								class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
								<option value="">—</option>
								for _, st := range staff {
									<option value={ st.ID } selected?={ st.ID == form.SoldByUserID }>{ st.Label }</option>
								}
							</select>
						</div>
						<div>
							<label for="customer_email" class="block text-sm font-medium text-gray-700 mb-1">Client (email du compte)</label>
							<input type="email" id="customer_email" name="customer_email" value={ form.CustomerEmail }
								class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"/>
						</div>
					</div>
					<div class="grid grid-cols-2 gap-4 mt-4">
						<div>
							<label for="price" class="block text-sm font-medium text-gray-700 mb-1">Prix (facultatif)</label>
							<input type="text" id="price" name="price" value={ form.Price } placeholder="150.00"
								class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"/>
						</div>
						<div>
							<label for="currency" class="block text-sm font-medium text-gray-700 mb-1">Devise</label>
							<input type="text" id="currency" name="currency" value={ form.Currency } maxlength="3" placeholder="USD"
								class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"/>
						</div>
					</div>
				</div>

				<button type="submit"
					class="rounded-lg bg-gray-900 hover:bg-gray-800 text-white text-sm font-medium px-5 py-2.5 transition-colors">
					if isNew {
						<span>Créer la campagne</span>
					} else {
						<span>Enregistrer</span>
					}
				</button>
			</form>
		</div>
	}
}

templ adField(label, name, inputType, value string, required bool, placeholder string) {
	<div>
		<label for={ name } class="block text-sm font-medium text-gray-700 mb-1">{ label }</label>
		<input
			type={ inputType }
			id={ name }
			name={ name }
			value={ value }
			required?={ required }
			placeholder={ placeholder }
			class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
		/>
	</div>
}

func adFormTitle(isNew bool) string {
	if isNew {
		return "Nouvelle campagne"
	}
	return "Modifier la campagne"
}
