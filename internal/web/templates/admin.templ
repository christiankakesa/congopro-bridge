package templates

// AdminAdRow is one row of the ads campaign list.
type AdminAdRow struct {
	ID          string
	Title       string
	Placement   string
	Status      string
	Period      string
	Weight      int
	SoldByEmail string
	UpdatedAt   string
}

// StaffOption backs the sold-by select.
type StaffOption struct {
	ID    string
	Label string
}

// AdminAdFormData backs the ads new/edit forms.
type AdminAdFormData struct {
	ID            string
	Title         string
	Description   string
	URL           string
	DisplayURL    string
	Label         string
	Color         string
	PeriodStart   string
	PeriodEnd     string
	Weight        string
	Placement     string
	Keywords      string // one per line
	Status        string
	SoldByUserID  string
	CustomerEmail string
	Price         string
	Currency      string
}

// AdminCompanyRow is one row in the admin companies list.
type AdminCompanyRow struct {
	ID        string
	Name      string
	Activity  string
	City      string
	Country   string
	Status    string
	UpdatedAt string
}

// AdminCompanyFormData backs both the "new company" and "edit company" forms.
type AdminCompanyFormData struct {
	ID           string
	Name         string
	NameSeo      string
	Activity     string
	City         string
	Country      string
	Description  string
	Slogan       string
	Website      string
	Email        string
	Phone        string
	AddressLine1 string
	AddressLine2 string
	Twitter      string
	Facebook     string
	LinkedIn     string
	Instagram    string
	TikTok       string
	Whatsapp     string
	Youtube      string
	StatsShow    bool
	Status       string
	Lon          string
	Lat          string
	UpdatedAt    string
}

// AdminNav is the per-request chrome state every admin page carries:
// who is signed in, the pending-claims badge, which nav item is active
// (derived from the request path), and an optional one-shot flash code
// (?flash=…) rendered as a toast.
type AdminNav struct {
	UserName      string
	Role          string
	PendingClaims int
	Active        string // "dashboard" | "companies" | "claims" | "ads"
	Flash         string
}

// AdminLayout is the internal-tool counterpart to Layout — no analytics, no
// cookie banner, no public SEO metadata (noindex instead). Desktop gets a
// sidebar, mobile a compact top bar. htmx is loaded here (same-origin,
// SameSite=Strict session cookie rides along); rule of the house: no hx-on,
// no eval-based trigger filters — the CSP forbids them.
templ AdminLayout(title, nonce string, nav AdminNav) {
	<!DOCTYPE html>
	<html lang="fr" class="h-full">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } · Congopro Admin</title>
			<meta name="robots" content="noindex,nofollow"/>
			@commonHead(nonce, CSSVersion)
			<script nonce={ nonce } src="/js/htmx.min.js"></script>
		</head>
		<body class="bg-surface text-ink antialiased min-h-full">
			if nav.UserName != "" {
				<div class="min-h-screen md:flex">
					<aside class="hidden md:flex md:flex-col md:w-60 shrink-0 gap-1 p-4 bg-surface-raised border-r border-line">
						@adminBrand()
						<nav class="mt-4 flex flex-col gap-1" aria-label="Navigation admin">
							@adminNavLink(nav, "dashboard", "/admin", "Tableau de bord", true)
							@adminNavLink(nav, "companies", "/admin/companies", "Entreprises", true)
							@adminNavLink(nav, "claims", "/admin/claims", "Réclamations", true)
							@adminNavLink(nav, "ads", "/admin/ads", "Publicités", true)
						</nav>
						<div class="mt-auto flex flex-col gap-3 text-xs">
							@themeToggle(nonce)
							<div class="flex items-center justify-between gap-2 p-2.5 rounded-xl bg-surface border border-line">
								<div class="min-w-0">
									<p class="text-[13px] font-semibold text-ink truncate">{ nav.UserName }</p>
									if nav.Role != "" {
										<p class="text-[11px] text-ink-faint">{ nav.Role }</p>
									}
								</div>
								<form method="post" action="/admin/logout">
									<button type="submit" class="text-ink-faint hover:text-ink" title="Déconnexion" aria-label="Déconnexion">
										<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12H3m0 0l4-4m-4 4l4 4M11 4h6a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-6"></path></svg>
									</button>
								</form>
							</div>
						</div>
					</aside>
					<div class="flex-1 min-w-0">
						<header class="md:hidden bg-surface-raised border-b border-line px-4 py-3 flex items-center justify-between gap-3">
							@adminBrand()
							<form method="post" action="/admin/logout">
								<button type="submit" class="text-xs text-ink-faint hover:text-ink">Déconnexion</button>
							</form>
						</header>
						<nav class="md:hidden flex items-center gap-1 px-3 py-2 bg-surface-raised border-b border-line overflow-x-auto text-sm" aria-label="Navigation admin">
							@adminNavLink(nav, "dashboard", "/admin", "Tableau de bord", false)
							@adminNavLink(nav, "companies", "/admin/companies", "Entreprises", false)
							@adminNavLink(nav, "claims", "/admin/claims", "Réclamations", false)
							@adminNavLink(nav, "ads", "/admin/ads", "Publicités", false)
						</nav>
						<main class="max-w-5xl px-4 sm:px-6 py-6 md:py-8">
							{ children... }
						</main>
					</div>
				</div>
			} else {
				<main class="max-w-5xl mx-auto px-4 sm:px-6 py-8">
					{ children... }
				</main>
			}
			@confirmDialog(nonce)
			<div id="toasts" class="fixed bottom-6 right-4 md:right-6 z-[95] flex flex-col items-end gap-2" role="status" aria-live="polite">
				if nav.Flash != "" {
					@adminToast(adminFlashMessage(nav.Flash))
				}
			</div>
		</body>
	</html>
}

templ adminBrand() {
	<a href="/admin" class="flex items-center gap-2.5 px-1">
		<img src="/images/favicon.svg" alt="" width="26" height="26" class="rounded-lg" aria-hidden="true"/>
		<span class="font-sora font-semibold text-[15px] text-ink">Congopro</span>
		<span class="text-[9.5px] font-semibold tracking-[0.07em] text-ink-faint border border-line rounded-md px-1.5 py-0.5">ADMIN</span>
	</a>
}

// withBadgeID: only the sidebar instance carries id="claimsBadge" (the oob
// swap target) — ids must stay unique across the two nav renderings.
templ adminNavLink(nav AdminNav, key, href, label string, withBadgeID bool) {
	<a
		href={ templ.URL(href) }
		class={ "flex items-center justify-between gap-2 rounded-xl px-3.5 py-2.5 text-sm font-medium whitespace-nowrap transition-colors " + adminNavClass(nav.Active == key) }
	>
		<span>{ label }</span>
		if key == "claims" && nav.PendingClaims > 0 {
			if withBadgeID {
				<span id="claimsBadge" class="inline-flex items-center justify-center min-w-5 h-5 px-1.5 rounded-full bg-accent text-white text-[11px] font-semibold">
					{ formatTotal(nav.PendingClaims) }
				</span>
			} else {
				<span class="inline-flex items-center justify-center min-w-5 h-5 px-1.5 rounded-full bg-accent text-white text-[11px] font-semibold">
					{ formatTotal(nav.PendingClaims) }
				</span>
			}
		}
	</a>
}

func adminNavClass(active bool) string {
	if active {
		return "bg-accent-soft text-accent"
	}
	return "text-ink-muted hover:bg-surface-sunken"
}

// AdminClaimsBadgeOOB refreshes the sidebar pending-claims badge after an
// htmx claim action.
templ AdminClaimsBadgeOOB(count int) {
	if count > 0 {
		<span id="claimsBadge" hx-swap-oob="outerHTML" class="inline-flex items-center justify-center min-w-5 h-5 px-1.5 rounded-full bg-accent text-white text-[11px] font-semibold">
			{ formatTotal(count) }
		</span>
	} else {
		<span id="claimsBadge" hx-swap-oob="outerHTML" class="hidden"></span>
	}
}

templ adminToast(msg string) {
	<div class="admin-toast flex items-center gap-2.5 px-4 py-3 rounded-xl bg-surface-raised border border-line shadow-card text-sm text-ink">
		<span class="flex items-center justify-center w-6 h-6 rounded-full bg-positive-soft text-positive shrink-0">
			<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
		</span>
		{ msg }
	</div>
}

// AdminToastOOB pushes a toast into #toasts from an htmx fragment response.
templ AdminToastOOB(msg string) {
	<div hx-swap-oob="afterbegin:#toasts">
		@adminToast(msg)
	</div>
}

// AdminFlashText maps the whitelisted flash codes to their toast text; the
// handlers reuse it for htmx out-of-band toasts.
func AdminFlashText(code string) string {
	return adminFlashMessage(code)
}

// adminFlashMessage maps the whitelisted ?flash= codes to their toast text.
func adminFlashMessage(code string) string {
	switch code {
	case "created":
		return "Créé — l'index de recherche se resynchronise."
	case "saved":
		return "Enregistré — l'index de recherche se resynchronise."
	case "approved":
		return "Réclamation approuvée, le demandeur est notifié."
	case "rejected":
		return "Réclamation refusée, le demandeur est notifié."
	case "settings":
		return "Réglages publicitaires enregistrés."
	default:
		return ""
	}
}

templ AdminLoginPage(nonce, errorMsg string) {
	@AdminLayout("Connexion", nonce, AdminNav{}) {
		<div class="max-w-sm mx-auto mt-16">
			<div class="mb-6">
				@adminBrand()
			</div>
			<h1 class="text-xl font-sora font-semibold text-ink mb-6">Connexion staff</h1>
			if errorMsg != "" {
				<div class="mb-4 rounded-xl bg-danger-soft border border-danger-soft text-danger text-sm px-4 py-3">
					{ errorMsg }
				</div>
			}
			<form method="post" action="/admin/login" class="space-y-4 bg-surface-raised rounded-2xl border border-line shadow-card p-5">
				<div>
					<label for="email" class="block text-sm font-medium text-ink-muted mb-1">Email</label>
					<input type="email" id="email" name="email" required autocomplete="username" class="field-input"/>
				</div>
				<div>
					<label for="password" class="block text-sm font-medium text-ink-muted mb-1">Mot de passe</label>
					<input type="password" id="password" name="password" required autocomplete="current-password" class="field-input"/>
				</div>
				<div>
					<label for="totp_code" class="block text-sm font-medium text-ink-muted mb-1">Code d'authentification (6 chiffres)</label>
					<input type="text" id="totp_code" name="totp_code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required autocomplete="one-time-code" class="field-input tracking-widest"/>
				</div>
				<button type="submit" class="btn btn-primary w-full">Se connecter</button>
			</form>
		</div>
	}
}

// confirmDialog styles htmx's hx-confirm. htmx implements that attribute
// with window.confirm(), which ignores the theme and prefixes the message
// with the hostname — a visible seam in an otherwise designed UI. Hooking
// htmx:confirm keeps hx-confirm as the single source of the question, so
// buttons need no extra markup beyond an optional danger variant.
//
// Native <dialog>.showModal() is doing the unglamorous work: focus trap,
// Escape to dismiss, background inert, backdrop element. Cancel takes
// initial focus deliberately — these actions email a real person.
templ confirmDialog(nonce string) {
	<dialog id="confirmDialog" class="confirm-dialog" aria-labelledby="confirmTitle">
		<form method="dialog" class="p-5">
			<p id="confirmTitle" class="font-sora font-semibold text-[15px] text-ink">Confirmer</p>
			<p id="confirmMessage" class="mt-2 text-sm text-ink-muted leading-relaxed"></p>
			<div class="mt-5 flex items-center justify-end gap-2">
				<button id="confirmCancel" value="cancel" class="btn btn-secondary h-9 px-4 text-xs">Annuler</button>
				<button id="confirmOk" value="ok" class="btn btn-primary h-9 px-4 text-xs">Confirmer</button>
			</div>
		</form>
	</dialog>
	<script nonce={ nonce }>
		(function () {
			var dlg = document.getElementById("confirmDialog");
			var msg = document.getElementById("confirmMessage");
			var ok = document.getElementById("confirmOk");
			var cancel = document.getElementById("confirmCancel");
			if (!dlg || typeof dlg.showModal !== "function") return; // no <dialog>: htmx falls back to window.confirm
			var pending = null;

			document.body.addEventListener("htmx:confirm", function (e) {
				if (!e.detail.question) return; // element has no hx-confirm
				e.preventDefault();
				pending = e.detail;
				msg.textContent = e.detail.question;
				var elt = e.detail.elt;
				ok.textContent = (elt.textContent || "Confirmer").trim() || "Confirmer";
				var danger = elt.getAttribute("data-confirm-variant") === "danger";
				ok.classList.toggle("btn-primary", !danger);
				ok.classList.toggle("btn-danger", danger);
				dlg.showModal();
				cancel.focus(); // these actions email someone — don't arm Enter on the destructive button
			});

			dlg.addEventListener("close", function () {
				var p = pending;
				pending = null;
				if (p && dlg.returnValue === "ok") p.issueRequest(true);
			});
		})();
	</script>
}
